# MerchantShield AI server environment template.
# Copy to .env and fill real values. NEVER commit the real .env.

# --- Server ---
PORT=8080
NODE_ENV=development

# --- Data ---
# SQLite is the default (no server install needed). When MONGODB_URI is set,
# the app uses MongoDB instead and SQLite is bypassed.
DATABASE_PATH=./data/merchantshield.db

# --- MongoDB (OPTIONAL; auto-enables the MongoDB store when present) ---
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/merchantshield?retryWrites=true&w=majority
# Leave empty to use the SQLite fallback.
MONGODB_URI=
MONGODB_DB_NAME=merchantshield

# --- Model ---
MODEL_PATH=./src/model/risk_model_v1.json
METRICS_REPORT_PATH=./src/model/metrics_report.json

# --- Razorpay webhook verification (REQUIRED for MANDATORY Part 2.2) ---
# Secret shown on the Razorpay Dashboard -> Settings -> Webhooks.
# The demo ships a default secret so the seeded webhooks verify correctly,
# but PRODUCTION deployments MUST override this with the real Razorpay value.
RAZORPAY_WEBHOOK_SECRET=razorpay_demo_secret_change_me

# --- Razorpay TEST-MODE integration (Orders API + Checkout) ---
# Create test keys on the Razorpay Dashboard -> Settings -> API Keys (test mode).
# Key IDs look like `rzp_test_...`. Real integration won't work without these.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# --- Business cost simulator constants (Part 5) ---
# False-positive cost: an estimated blend of lost AOV + goodwill + support touch.
FALSE_POSITIVE_COST=250
# Review cost per manually reviewed transaction (fraud analyst labor).
REVIEW_COST=25
# False-negative cost: average chargeback loss incl. dispute fee (INR).
FALSE_NEGATIVE_COST=900
# Average order value used in cost modelling.
AVG_ORDER_VALUE=2000
